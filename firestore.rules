rules_version = '2';

// All reads/writes go through the Next.js server using the Firebase Admin
// SDK, which bypasses these rules entirely (see research.md's "Firestore
// access via Admin SDK only" decision). Client-side Firestore SDK access is
// never used in this app, so these rules simply deny it outright.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
